  "decisions": [
    {
      "at": "2026-11-03T20:39:29Z",
      "by": "attendee",
      "text": "Score weights 40/35/25 (vibration/defects/yield); top_driver = highest unweighted percentile"
    },
    {
      "at": "2026-11-03T21:01:58Z",
      "by": "attendee",
      "text": "Predictions live inside machine-worklist app"
    },
    {
      "at": "2026-11-03T21:01:58Z",
      "by": "attendee",
      "text": "Label = serious or critical defect within next 7 days"
    },
    {
      "at": "2026-11-03T21:07:33Z",
      "by": "attendee",
      "text": "Git: local commits only, one commit per build step; export ZIP at end"
    },
    {
      "at": "2026-11-03T21:10:14Z",
      "by": "attendee",
      "text": "Label = 11+ major/critical defects in next 7 days (worst ~10% of machine-weeks); replaces 'any serious defect'"
    },
    {
      "at": "2026-11-03T21:18:27Z",
      "by": "attendee",
      "text": "Model: sklearn HistGradientBoosting (no PyPI on serverless); drivers = what-if (replace feature with typical training value), not SHAP"
    },
    {
      "at": "2026-11-03T21:28:34Z",
      "by": "attendee",
      "text": "Label = machine in fleet's worst 10% by major/critical defects over next 7 days (relative, per day); replaces absolute 11+"
    },
    {
      "at": "2026-11-03T22:00:07Z",
      "by": "attendee",
      "text": "App: rank by rule; model shown as second opinion (lift vs fleet average, what-if drivers) + rule-vs-model evidence panel"
    },
    {
      "at": "2026-11-03T22:06:52Z",
      "by": "attendee",
      "text": "Attention weights 30/15/30/25 (vibration/temperature/defects/yield); temperature = abs change of 7d avg vs prior 7d, percentile within type"
    },
    {
      "at": "2026-11-03T22:06:52Z",
      "by": "attendee",
      "text": "Genie chat as slide-out 'Ask the data' panel; space over 4 workshop_demo.manufacturing tables + machine_attention + machine_risk_7d"
    }
  ],
